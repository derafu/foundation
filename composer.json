{
    "name": "derafu/foundation",
    "description": "Derafu: Foundation - Base of dependencies for Derafu's web applications",
    "type": "library",
    "homepage": "https://www.derafu.dev/docs/core/foundation",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/foundation/issues",
        "source": "https://github.com/derafu/foundation"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\Foundation\\": "src/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/captcha": "dev-main",
        "derafu/contact-form": "dev-main",
        "derafu/content": "dev-main",
        "derafu/csrf": "dev-main",
        "derafu/data-processor": "dev-main",
        "derafu/form": "dev-main",
        "derafu/http": "dev-main",
        "derafu/kernel": "dev-main",
        "derafu/markdown": "^2.0",
        "derafu/renderer": "dev-main",
        "derafu/routing": "dev-main",
        "derafu/session": "dev-main",
        "derafu/support": "dev-main",
        "derafu/translation": "dev-main",
        "derafu/twig": "dev-main",
        "guzzlehttp/guzzle": "^7.10",
        "mpdf/mpdf": "^8.3",
        "symfony/cache": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "suggest": {
        "phpunit/phpunit": "To test a site with Derafu\\Foundation\\Testing\\SiteTestCase."
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
