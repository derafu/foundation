{
    "name": "derafu/foundation",
    "description": "Derafu: Foundation - Base of dependencies for Derafu's web applications",
    "type": "library",
    "homepage": "https://www.derafu.dev/docs/core/foundation",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
